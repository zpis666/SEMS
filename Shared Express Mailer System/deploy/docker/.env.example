# 本地开发中间件配置（可选）
# 用法：复制本文件为同目录下的 .env 后按需修改；不复制也能启动，
#       docker-compose.yml 内置了完全相同的默认值（取值的第二顺位）。
# 注意：这里只是本地开发口令，生产环境的口令一律通过环境变量注入，
#       严禁把生产口令写进任何入库文件。

MYSQL_ROOT_PASSWORD=root_dev_pwd
MYSQL_DATABASE=sems
MYSQL_USER=sems
MYSQL_PASSWORD=sems_dev_pwd
MYSQL_PORT=3306

REDIS_PASSWORD=redis_dev_pwd
REDIS_PORT=6379
